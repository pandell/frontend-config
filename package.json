{
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "format": "prettier --experimental-cli --log-level warn --check .",
    "format-fix": "prettier --experimental-cli --write .",
    "lint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/eslint.cache",
    "verify": "pnpm run format && pnpm run build && pnpm run lint",
    "versions": "echo '[node]' && node --version && echo '\n[pnpm]' && pnpm --version && echo '\n[prettier]' && prettier --version && echo '\n[eslint]' && eslint --version && echo '\n[tsc]' && tsc --version && echo '\n[browserslist]' && browserslist --version"
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@pandell/eslint-config": "workspace:*",
    "@pandell/prettier-config": "workspace:*",
    "@pandell/typescript-config": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "browserslist": "^4.28.9",
    "eslint": "^10.10.0",
    "eslint-formatter-teamcity": "^2.0.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "eslint-formatter-teamcity": {
    "error-statistics-name": "ESLint Error Count",
    "report-name": "ESLint Violations",
    "reporter": "inspections",
    "warning-statistics-name": "ESLint Warning Count"
  },
  "prettier": "@pandell/prettier-config"
}
